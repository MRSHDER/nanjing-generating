{
  "name": "nanjing-short",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/render.mjs stills",
    "music": "node music/compose.mjs",
    "build": "npm run music && vite build --target esnext --base ./ && mkdir -p dist/out/music && cp out/music/score.wav dist/out/music/score.wav"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.8",
    "three": "^0.169.0"
  }
}
